# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Connection String (e.g. Neon Serverless Postgres, Render, or Local)
# Example Neon URL: postgresql://username:password@ep-cool-butterfly-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bees_treatz?schema=public"

# Stripe Payment Keys (Get these from your Stripe Dashboard -> Developers -> API keys)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"

# JWT Authentication
JWT_SECRET="super-secret-bees-treatz-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Restaurant Operating Address / Delivery Configuration (UK Postcode)
# Example: Peckham, London (SE15 5BA) or Central London or Birmingham
RESTAURANT_POSTCODE="SE15 5BA"
MAX_DELIVERY_DISTANCE_MILES=6.0
BASE_DELIVERY_FEE=3.50
PER_MILE_FEE=0.80
FREE_DELIVERY_THRESHOLD=50.00
